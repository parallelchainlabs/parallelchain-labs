# Normalize text to LF in the repo. Overrides core.autocrlf so Windows
# Git Bash does not warn about LF/CRLF on checkout.
* text=auto eol=lf

# Binary assets — do not convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
